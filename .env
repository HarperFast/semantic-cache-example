OLLAMA_HOST=http://127.0.0.1:11434 # The host address of the ollama server
OLLAMA_EMBEDDING_MODEL=nomic-embed-text # The name of the ollama embedding model
OLLAMA_SEARCH_MODEL=falcon:7b # The name of the ollama model to use for the chat
SIMILARITY_THRESHOLD=0.1 # the similarity threshold used to find related items in the semantic cache