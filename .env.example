# Which model backend to use for both embedding and chat: ollama | gemini
MODEL_PROVIDER=ollama

# Similarity threshold for the semantic cache (lower = stricter match)
SIMILARITY_THRESHOLD=0.1

# --- Ollama (used when MODEL_PROVIDER=ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_SEARCH_MODEL=falcon:7b

# --- Gemini (used when MODEL_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash
